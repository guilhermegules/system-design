    {
      "id": "LW7MQ5wXtiRuNwRAlWBjB",
      "type": "text",
      "x": -373.6809808640254,
      "y": -1026.8650793650786,
      "width": 1233.2667236328125,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "atV",
      "roundness": null,
      "seed": 1743317845,
      "version": 285,
      "versionNonce": 2072040571,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771436271449,
      "link": null,
      "locked": false,
      "text": "Calcular estimativas\n\n\n\nOperacaoes de streaming: 100 milhões de usuários por dia =\n100.000.000 * 5 = 500.000.000 views dia\nCapacidade de armazenamento: 256GB por video = 1 milhão * 256Gb =\n256 Petabytes / dia\nLatência de streaming: 400ms",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Bl_NyZEHLUYl1waoQArcw",
      "originalText": "Calcular estimativas\n\n\n\nOperacaoes de streaming: 100 milhões de usuários por dia = 100.000.000 * 5 = 500.000.000 views dia\nCapacidade de armazenamento: 256GB por video = 1 milhão * 256Gb = 256 Petabytes / dia\nLatência de streaming: 400ms",
      "autoResize": true,
      "lineHeight": 1.25
    },
