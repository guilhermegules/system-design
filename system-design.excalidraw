      "versionNonce": 328152040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743082600869,
      "link": null,
      "locked": false,
      "text": "REST\n\n- Stateless\n- Standard HTTP Methods\n- Over-Fetching and Under-Fetching\n- JSON for data exchange",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "REST\n\n- Stateless\n- Standard HTTP Methods\n- Over-Fetching and Under-Fetching\n- JSON for data exchange",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y8LF25Qb4a9dwL-9_eJh6",
      "type": "text",
      "x": 3192.875653994494,
      "y": 3021.7531815408415,
      "width": 631.3997802734375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6T",
      "roundness": null,
      "seed": 1907636456,
      "version": 407,
      "versionNonce": 931679720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743082603503,
      "link": null,
      "locked": false,
      "text": "GraphQL\n\n- Strongly typed schema based on queries\n- Avoids Over-Fetching and Under-Fetching\n- Queries can impact server perfomance\n- Only Post requests\n- Respons with HTTP 200",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GraphQL\n\n- Strongly typed schema based on queries\n- Avoids Over-Fetching and Under-Fetching\n- Queries can impact server perfomance\n- Only Post requests\n- Respons with HTTP 200",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZR4kzrw4-6F2aZq_c8rVu",
      "type": "text",
      "x": 2653.3905260002434,
      "y": 3305.0930931616217,
      "width": 431.1998291015625,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6U",
      "roundness": null,
      "seed": 564303512,
      "version": 586,
      "versionNonce": 820530152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743082606822,
      "link": null,
      "locked": false,
      "text": "gRPC\n\n- HTTP/2\n- Multiplexing / server push\n- Uses protocol buffers\n- Efficient\n- Less human readable",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gRPC\n\n- HTTP/2\n- Multiplexing / server push\n- Uses protocol buffers\n- Efficient\n- Less human readable",
      "autoResize": true,
      "lineHeight": 1.25
    },
