      "version": 177,
      "versionNonce": 1170306874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1746451621535,
      "link": null,
      "locked": false,
      "text": "Entidades Core:\n\n- Substantivos relacionados aos requisitos funcionais, únicos no sistema\n- Ex: Passageiro, corrida, localização (Origem e destino)\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entidades Core:\n\n- Substantivos relacionados aos requisitos funcionais, únicos no sistema\n- Ex: Passageiro, corrida, localização (Origem e destino)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
